+/// Publish the ACP final answer through the harness signer. The model process
+/// never receives the Nostr key. Owner-facing replies stay flat at the trigger's
+/// thread root, or open a new thread rooted at a top-level trigger.
+async fn post_final_answer(
+    rest: &crate::relay::RestClient,
+    batch: &FlushBatch,
+    content: &str,
+) -> Result<(), String> {
+    let triggering = batch
+        .events
+        .last()
+        .ok_or_else(|| "cannot publish a response for an empty batch".to_string())?;
+    let thread_tags = crate::queue::parse_thread_tags(&triggering.event);
+    let root_id = match thread_tags.root_event_id.as_deref() {
+        Some(root) => nostr::EventId::from_hex(root)
+            .map_err(|error| format!("invalid thread root: {error}"))?,
+        None => triggering.event.id,
+    };
+    let thread_ref = buzz_sdk::ThreadRef {
+        root_event_id: root_id,
+        parent_event_id: root_id,
+    };
+    let author = triggering.event.pubkey.to_hex();
+    let event = buzz_sdk::build_message(
+        batch.channel_id,
+        content,
+        Some(&thread_ref),
+        &[&author],
+        false,
+        &[],
+    )
+    .map_err(|error| format!("build failed: {error}"))?
+    .sign_with_keys(&rest.keys)
+    .map_err(|error| format!("sign failed: {error}"))?;
+
+    tokio::time::timeout(Duration::from_secs(5), rest.submit_event(&event))
+        .await
+        .map_err(|_| "publish timed out".to_string())?
+        .map_err(|error| format!("publish failed: {error}"))?;
+    Ok(())
+}
