+/// Match the literal display-name mention clients leave in message text
+/// when they omit the structured Nostr `p` tag. The caller still applies the
+/// cryptographic owner gate before using this as a trigger.
+fn textual_agent_mention(content: &str, display_name: &str) -> bool {
+    let display_name = display_name.trim();
+    if display_name.is_empty() {
+        return false;
+    }
+    let content = content.trim_start();
+    let prefix = format!("@{display_name}");
+    let Some(head) = content.get(..prefix.len()) else {
+        return false;
+    };
+    if !head.eq_ignore_ascii_case(&prefix) {
+        return false;
+    }
+    content[prefix.len()..]
+        .chars()
+        .next()
+        .is_none_or(|ch| ch.is_whitespace() || matches!(ch, ':' | ',' | ';' | '-' | '—'))
+}
+
+fn configured_textual_mention(event: &nostr::Event) -> bool {
+    let Ok(display_name) = std::env::var("BUZZ_ACP_TEXT_MENTION") else {
+        return false;
+    };
+    textual_agent_mention(&event.content, &display_name)
+}
+
+/// Fail-closed continuation check for client thread replies that omit a `p`
+/// tag. Some clients flatten replies onto the thread root, so accept only when
+/// this agent has a valid signed reply in the same channel and thread.
+async fn replies_to_agent(
+    event: &nostr::Event,
+    channel_id: Uuid,
+    agent_pubkey: &str,
+    rest_client: &relay::RestClient,
+) -> bool {
+    if !env_truthy("BUZZ_ACP_FOLLOW_OWN_THREADS") {
+        return false;
+    }
+    let Some(root_hex) = queue::parse_thread_tags(event).root_event_id else {
+        return false;
+    };
+    if nostr::EventId::from_hex(&root_hex).is_err() {
+        return false;
+    }
+    let Ok(agent_key) = nostr::PublicKey::from_hex(agent_pubkey) else {
+        return false;
+    };
+    use nostr::{Alphabet, SingleLetterTag};
+    let filter = nostr::Filter::new()
+        .kinds([
+            nostr::Kind::Custom(buzz_core::kind::KIND_STREAM_MESSAGE as u16),
+            nostr::Kind::Custom(buzz_core::kind::KIND_STREAM_MESSAGE_V2 as u16),
+        ])
+        .author(agent_key)
+        .custom_tags(SingleLetterTag::lowercase(Alphabet::E), [&root_hex])
+        .custom_tags(
+            SingleLetterTag::lowercase(Alphabet::H),
+            [channel_id.to_string()],
+        )
+        .limit(1);
+    let response =
+        match tokio::time::timeout(Duration::from_secs(2), rest_client.query(&[filter])).await {
+            Ok(Ok(value)) => value,
+            _ => return false,
+        };
+    response_contains_agent_thread_reply(&response, &root_hex, channel_id, agent_pubkey)
+}
+
+fn response_contains_agent_thread_reply(
+    response: &serde_json::Value,
+    root_id: &str,
+    channel_id: Uuid,
+    agent_pubkey: &str,
+) -> bool {
+    let expected_channel = channel_id.to_string();
+    response
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|value| serde_json::from_value::<nostr::Event>(value.clone()).ok())
+        .any(|reply| {
+            let valid_kind = matches!(
+                reply.kind.as_u16() as u32,
+                buzz_core::kind::KIND_STREAM_MESSAGE | buzz_core::kind::KIND_STREAM_MESSAGE_V2
+            );
+            let same_channel = reply.tags.iter().any(|tag| {
+                let parts = tag.as_slice();
+                parts.first().map(String::as_str) == Some("h")
+                    && parts.get(1).map(String::as_str) == Some(expected_channel.as_str())
+            });
+            let same_root = queue::parse_thread_tags(&reply)
+                .root_event_id
+                .is_some_and(|candidate| candidate.eq_ignore_ascii_case(root_id));
+            valid_kind
+                && same_channel
+                && same_root
+                && reply.pubkey.to_hex() == agent_pubkey
+                && reply.verify().is_ok()
+        })
+}
