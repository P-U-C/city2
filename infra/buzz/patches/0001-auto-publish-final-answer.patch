+fn env_truthy(name: &str) -> bool {
+    matches!(std::env::var(name).as_deref(), Ok("1" | "true" | "yes"))
+}
+
+/// Match the literal display-name mention mobile clients leave in message text
+/// when they omit the structured Nostr `p` tag. The caller still applies the
+/// cryptographic owner gate before using this as a trigger.
+fn textual_agent_mention(content: &str, display_name: &str) -> bool {
+    let display_name = display_name.trim();
+    if display_name.is_empty() {
+        return false;
+    }
+    let content = content.trim_start();
+    let prefix = format!("@{display_name}");
+    let Some(head) = content.get(..prefix.len()) else {
+        return false;
+    };
+    if !head.eq_ignore_ascii_case(&prefix) {
+        return false;
+    }
+    content[prefix.len()..]
+        .chars()
+        .next()
+        .is_none_or(|ch| ch.is_whitespace() || matches!(ch, ':' | ',' | ';' | '-' | '—'))
+}
+
+fn configured_textual_mention(event: &nostr::Event) -> bool {
+    let Ok(display_name) = std::env::var("BUZZ_ACP_TEXT_MENTION") else {
+        return false;
+    };
+    textual_agent_mention(&event.content, &display_name)
+}
+
+/// Fail-closed continuation check for mobile thread replies that omit a `p`
+/// tag. Only an immediate reply to a valid event signed by this agent passes.
+async fn replies_to_agent(
+    event: &nostr::Event,
+    agent_pubkey: &str,
+    rest_client: &relay::RestClient,
+) -> bool {
+    if !env_truthy("BUZZ_ACP_FOLLOW_OWN_THREADS") {
+        return false;
+    }
+    let Some(parent_hex) = queue::parse_thread_tags(event).parent_event_id else {
+        return false;
+    };
+    let Ok(parent_id) = nostr::EventId::from_hex(&parent_hex) else {
+        return false;
+    };
+    let filter = nostr::Filter::new().id(parent_id).limit(1);
+    let response =
+        match tokio::time::timeout(Duration::from_secs(2), rest_client.query(&[filter])).await {
+            Ok(Ok(value)) => value,
+            _ => return false,
+        };
+    response_contains_agent_parent(&response, parent_id, agent_pubkey)
+}
+
+fn response_contains_agent_parent(
+    response: &serde_json::Value,
+    parent_id: nostr::EventId,
+    agent_pubkey: &str,
+) -> bool {
+    response
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|value| serde_json::from_value::<nostr::Event>(value.clone()).ok())
+        .any(|parent| {
+            parent.id == parent_id
+                && parent.pubkey.to_hex() == agent_pubkey
+                && parent.verify().is_ok()
+        })
+}
