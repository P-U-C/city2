+        let mut tags = vec![Tag::parse(["h", &channel_id.to_string()]).unwrap()];
+        if let Some(pubkey) = mention {
+            tags.push(Tag::parse(["p", pubkey]).unwrap());
+        }
+        EventBuilder::new(Kind::Custom(kind), "catch-up")
+            .tags(tags)
+            .sign_with_keys(keys)
+            .unwrap()
+    }
+
+    #[test]
+    fn persisted_catchup_filter_matches_live_subscription_contract() {
+        let channel_id = Uuid::new_v4();
+        let agent = nostr::Keys::generate().public_key().to_hex();
+        let mut subscription = CatchupSubscription {
+            channel_id,
+            filter: ChannelFilter {
+                kinds: Some(vec![9, 1009]),
+                require_mention: false,
+            },
+            since: 1_000,
+        };
+
+        let plain: serde_json::Value =
+            serde_json::to_value(build_catchup_filter(&subscription, &agent)).unwrap();
+        assert_eq!(plain["#h"], serde_json::json!([channel_id.to_string()]));
+        assert_eq!(plain["kinds"], serde_json::json!([9, 1009]));
+        assert_eq!(plain["since"], serde_json::json!(995));
+        assert!(plain.get("#p").is_none());
+
+        subscription.filter.require_mention = true;
+        let mentioned: serde_json::Value =
+            serde_json::to_value(build_catchup_filter(&subscription, &agent)).unwrap();
+        assert_eq!(mentioned["#p"], serde_json::json!([agent]));
+    }
