+    #[test]
+    fn persisted_catchup_accepts_valid_unmentioned_thread_event_and_rejects_drift() {
+        let author = nostr::Keys::generate();
+        let agent = nostr::Keys::generate().public_key().to_hex();
+        let channel_id = Uuid::new_v4();
+        let subscription = CatchupSubscription {
+            channel_id,
+            filter: test_channel_filter(),
+            since: 1_000,
+        };
+        let unmentioned = make_catchup_event(&author, channel_id, 9, None);
+        assert!(catchup_event_matches(&unmentioned, &subscription, &agent));
+
+        let wrong_channel = make_catchup_event(&author, Uuid::new_v4(), 9, None);
+        assert!(!catchup_event_matches(
+            &wrong_channel,
+            &subscription,
+            &agent
+        ));
+        let wrong_kind = make_catchup_event(&author, channel_id, 10, None);
+        assert!(!catchup_event_matches(&wrong_kind, &subscription, &agent));
+
+        let mention_required = CatchupSubscription {
+            filter: ChannelFilter {
+                kinds: Some(vec![9]),
+                require_mention: true,
+            },
+            ..subscription
+        };
+        assert!(!catchup_event_matches(
+            &unmentioned,
+            &mention_required,
+            &agent
+        ));
+        let mentioned = make_catchup_event(&author, channel_id, 9, Some(&agent));
+        assert!(catchup_event_matches(&mentioned, &mention_required, &agent));
+    }
