+/// Query all active channel subscriptions in one authenticated HTTP request.
+/// Results pass the same channel/kind/mention constraints as the live REQ and
+/// are sorted oldest-first before entering the shared delivery dedup boundary.
+async fn query_persisted_catchup(
+    rest: &RestClient,
+    agent_pubkey_hex: &str,
+    subscriptions: Vec<CatchupSubscription>,
+) -> Result<Vec<BuzzEvent>, RelayError> {
+    if subscriptions.is_empty() {
+        return Ok(Vec::new());
+    }
