#!/usr/bin/env bash
set -euo pipefail

# buzz-acp needs the Nostr key to sign relay traffic; the model runtime does
# not. Prevent the ACP/Codex child and every tool it launches from inheriting
# that identity secret or the systemd credential-directory handle.
unset BUZZ_PRIVATE_KEY
unset CREDENTIALS_DIRECTORY

exec /opt/city2/bin/codex-acp
