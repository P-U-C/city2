#!/usr/bin/env bash
set -euo pipefail

require() {
  local name="$1"
  [[ -n "${!name:-}" ]] || {
    echo "buzz-agent-launcher: missing ${name}" >&2
    exit 1
  }
}

for name in \
  BUZZ_AGENT_WORKDIR \
  BUZZ_RELAY_URL \
  BUZZ_PRIVATE_KEY \
  BUZZ_ACP_AGENT_OWNER \
  BUZZ_ACP_AGENT_COMMAND \
  BUZZ_ACP_MCP_COMMAND \
  BUZZ_AGENT_HARNESS; do
  require "${name}"
done

BIN_DIR="${CITY2_BIN_DIR:-/opt/city2/bin}"
[[ -x "${BIN_DIR}/buzz-acp" ]] || {
  echo "buzz-agent-launcher: buzz-acp is unavailable" >&2
  exit 1
}

[[ -d "${BUZZ_AGENT_WORKDIR}" ]] || {
  echo "buzz-agent-launcher: workdir does not exist" >&2
  exit 1
}

case "${BUZZ_AGENT_HARNESS}" in
  pfterminal-chatgpt)
    require CITY2_SHARED_AUTH_FILE
    credential="${CITY2_SHARED_AUTH_FILE}"
    [[ -r "${credential}" ]] || {
      echo "buzz-agent-launcher: PfTerminal ChatGPT credential is unavailable" >&2
      exit 1
    }
    require HOME
    require CODEX_HOME
    install -d -m 0700 "${HOME}" "${CODEX_HOME}"
    if [[ -n "${APP_SERVER_LOGS:-}" ]]; then
      install -d -m 0700 "${APP_SERVER_LOGS}"
    fi
    [[ -s "${credential}" ]] || {
      echo "buzz-agent-launcher: PfTerminal ChatGPT credential is empty" >&2
      exit 1
    }
    ln -s "${credential}" "${CODEX_HOME}/auth.json"
    cat >"${CODEX_HOME}/config.toml" <<'EOF'
approval_policy = "never"
sandbox_mode = "danger-full-access"

[features]
apps = false
code_mode = false
goals = false
hooks = false
memories = false
multi_agent = false
plugins = false
tool_suggest = false

[tools]
view_image = false
web_search = false
EOF
    chmod 0600 "${CODEX_HOME}/config.toml"

    # This LXC cannot host Codex's nested Linux sandbox, while systemd already
    # supplies the reviewed read-only filesystem and process boundary. GPT-5.6
    # models currently force a V8 code-mode executor that conflicts with
    # MemoryDenyWriteExecute, so pin the strongest available direct-tool model.
    export BUZZ_ACP_MODEL="${BUZZ_ACP_MODEL:-gpt-5.5}"
    [[ "${BUZZ_ACP_MODEL}" == "gpt-5.5" ]] || {
      echo "buzz-agent-launcher: unsupported coordinator model ${BUZZ_ACP_MODEL}" >&2
      exit 1
    }
    export CODEX_HOME
    export NO_BROWSER=1
    export INITIAL_AGENT_MODE=agent-full-access
    unset credential
    ;;
  *)
    echo "buzz-agent-launcher: unsupported harness" >&2
    exit 1
    ;;
esac

cd "${BUZZ_AGENT_WORKDIR}"
exec "${BIN_DIR}/buzz-acp"
