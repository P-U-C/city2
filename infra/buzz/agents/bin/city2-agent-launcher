#!/usr/bin/env bash
set -euo pipefail

require() {
  local name="$1"
  [[ -n "${!name:-}" ]] || {
    echo "buzz-agent-launcher: missing ${name}" >&2
    exit 1
  }
}

for name in \
  BUZZ_AGENT_WORKDIR \
  BUZZ_RELAY_URL \
  BUZZ_PRIVATE_KEY \
  BUZZ_ACP_AGENT_OWNER \
  BUZZ_ACP_AGENT_COMMAND \
  BUZZ_ACP_MCP_COMMAND \
  BUZZ_AGENT_HARNESS; do
  require "${name}"
done

BIN_DIR="${CITY2_BIN_DIR:-/opt/city2/bin}"
[[ -x "${BIN_DIR}/buzz-acp" ]] || {
  echo "buzz-agent-launcher: buzz-acp is unavailable" >&2
  exit 1
}

[[ -d "${BUZZ_AGENT_WORKDIR}" ]] || {
  echo "buzz-agent-launcher: workdir does not exist" >&2
  exit 1
}

case "${BUZZ_AGENT_HARNESS}" in
  pfterminal-chatgpt)
    require CITY2_SHARED_AUTH_FILE
    credential="${CITY2_SHARED_AUTH_FILE}"
    [[ -r "${credential}" ]] || {
      echo "buzz-agent-launcher: PfTerminal ChatGPT credential is unavailable" >&2
      exit 1
    }
    require HOME
    require CODEX_HOME
    install -d -m 0700 "${HOME}" "${CODEX_HOME}"
    if [[ -n "${APP_SERVER_LOGS:-}" ]]; then
      install -d -m 0700 "${APP_SERVER_LOGS}"
    fi
    [[ -s "${credential}" ]] || {
      echo "buzz-agent-launcher: PfTerminal ChatGPT credential is empty" >&2
      exit 1
    }
    ln -s "${credential}" "${CODEX_HOME}/auth.json"
    export CODEX_HOME
    export NO_BROWSER=1
    export INITIAL_AGENT_MODE=read-only
    unset credential
    ;;
  *)
    echo "buzz-agent-launcher: unsupported harness" >&2
    exit 1
    ;;
esac

cd "${BUZZ_AGENT_WORKDIR}"
exec "${BIN_DIR}/buzz-acp"
