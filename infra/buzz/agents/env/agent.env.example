# Generated agent identity/runtime file. Real file must be mode 0600.
BUZZ_AGENT_WORKDIR=/home/CHANGE_ME_USER/CHANGE_ME_WORKDIR
BUZZ_RELAY_URL=ws://CHANGE_ME_RELAY_HOST:3000
BUZZ_PRIVATE_KEY=CHANGE_ME_AGENT_NOSTR_PRIVATE_KEY
BUZZ_ACP_AGENT_OWNER=CHANGE_ME_OWNER_PUBLIC_KEY
BUZZ_ACP_DISPLAY_NAME="City 2.0 Coordinator"

BUZZ_ACP_AGENT_COMMAND=/opt/city2/bin/city2-codex-acp-launcher
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_MCP_COMMAND=

# The service receives only PfTerminal's ChatGPT auth through systemd.
BUZZ_AGENT_HARNESS=pfterminal-chatgpt
BUZZ_ACP_MODEL=gpt-5.5
# Codex runs unsandboxed only inside the hardened, read-only systemd namespace.
INITIAL_AGENT_MODE=agent-full-access
NO_BROWSER=1

# Conservative first-proof behavior.
BUZZ_ACP_SYSTEM_PROMPT_FILE=/opt/city2/prompts/coordinator.md
BUZZ_ACP_RESPOND_TO=owner-only
BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only
BUZZ_ACP_SUBSCRIBE=mentions
BUZZ_ACP_AGENTS=1
BUZZ_ACP_LAZY_POOL=true
BUZZ_ACP_DEDUP=queue
BUZZ_ACP_MULTIPLE_EVENT_HANDLING=queue
BUZZ_ACP_PERMISSION_MODE=dont-ask
BUZZ_ACP_AUTO_PUBLISH_FINAL=true
BUZZ_ACP_HEARTBEAT_INTERVAL=0
BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=20
BUZZ_ACP_MAX_TURNS_PER_SESSION=20
BUZZ_ACP_IDLE_TIMEOUT=300
BUZZ_ACP_MAX_TURN_DURATION=1800
BUZZ_ACP_NO_MEMORY=true
