# Immutable reviewed relay image.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:a2b59030b29242adb0783a05cbabd63f51518fdfe7b724845a68f77adab7e1f9

# Private pilot network. Use a local Tailscale IPv4 address for remote desktop access.
BUZZ_BIND_IP=CHANGE_ME_BIND_IP
BUZZ_HTTP_PORT=3000
BUZZ_DOMAIN=CHANGE_ME_RELAY_HOST
RELAY_URL=ws://CHANGE_ME_RELAY_HOST:3000
BUZZ_MEDIA_BASE_URL=http://CHANGE_ME_RELAY_HOST:3000/media
BUZZ_MEDIA_SERVER_DOMAIN=CHANGE_ME_RELAY_HOST
BUZZ_CORS_ORIGINS=http://CHANGE_ME_RELAY_HOST:3000

# Closed relay defaults.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Public Nostr key of the human owner. Never put the private owner key here.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable server-side secrets. Generate once and back up securely.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_RANDOM_64_HEX
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path
