#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./city2 <command> [args]

  doctor              Read-only host/project capability report
  validate            Run static and contract checks
  fleet [options]     Read-only producer inventory/health
  workstreams [args]  Inspect channel/task/agent workstream plans
  agent <request>     Run a PfTerminal turn rooted in this repository
  review              Review uncommitted changes in a read-only boundary
  core <command>      Operate the local Company OS Core ledger
  buzz <command>      Run the explicit Buzz lifecycle wrapper
  status              Concise Git and relay status
  version             Print City2 and PfTerminal versions
EOF
}

require_pfterminal() {
  command -v pfterminal >/dev/null 2>&1 || {
    echo "city2: pfterminal is required" >&2
    exit 1
  }
}

case "${1:-help}" in
  doctor)
    exec "${ROOT}/scripts/doctor.sh"
    ;;
  validate)
    exec "${ROOT}/scripts/validate.sh"
    ;;
  fleet)
    shift
    exec "${ROOT}/scripts/fleet_status.py" "$@"
    ;;
  workstreams)
    shift
    exec "${ROOT}/scripts/workstream_status.py" "$@"
    ;;
  agent)
    shift
    [[ "$#" -gt 0 ]] || {
      echo 'Usage: ./city2 agent "<request>"' >&2
      exit 2
    }
    require_pfterminal
    export CODEX_HOME="${CODEX_HOME:-${HOME}/.codex}"
    exec pfterminal exec -C "${ROOT}" "$*"
    ;;
  review)
    shift
    [[ "$#" -eq 0 ]] || {
      echo "city2: custom review prompts are unsupported by this PfTerminal version" >&2
      exit 2
    }
    require_pfterminal
    command -v systemd-run >/dev/null 2>&1 || {
      echo "city2: systemd-run is required for contained reviews" >&2
      exit 1
    }
    command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1 || {
      echo "city2: passwordless sudo is required for contained reviews" >&2
      exit 1
    }
    PFTERMINAL_BIN="$(readlink -f "$(command -v pfterminal)")"
    PFTERMINAL_INSTALL="$(cd "$(dirname "${PFTERMINAL_BIN}")/.." && pwd)"
    PFTERMINAL_CONFIG="${HOME}/.pfterminal/config.toml"
    CODEX_AUTH="${HOME}/.codex/auth.json"
    [[ -f "${PFTERMINAL_CONFIG}" ]] || {
      echo "city2: missing PfTerminal configuration: ${PFTERMINAL_CONFIG}" >&2
      exit 1
    }
    [[ -f "${CODEX_AUTH}" ]] || {
      echo "city2: missing Codex authentication file: ${CODEX_AUTH}" >&2
      exit 1
    }
    REVIEW_STATE="$(mktemp -d /tmp/city2-review-state.XXXXXX)"
    trap 'rm -rf "${REVIEW_STATE}"' EXIT
    install -m 0600 "${PFTERMINAL_CONFIG}" "${REVIEW_STATE}/config.toml"
    install -m 0600 /dev/null "${REVIEW_STATE}/auth.json"
    export CODEX_HOME="${REVIEW_STATE}"
    sudo -n systemd-run --quiet --wait --pipe --collect \
      --service-type=exec \
      --uid="$(id -u)" \
      --gid="$(id -g)" \
      --working-directory="${ROOT}" \
      --setenv="HOME=${HOME}" \
      --setenv="CODEX_HOME=${CODEX_HOME}" \
      --setenv="PATH=${PATH}" \
      --setenv="TERM=${TERM:-dumb}" \
      --property=NoNewPrivileges=yes \
      --property=CapabilityBoundingSet= \
      --property=ProtectHome=tmpfs \
      --property=ProtectSystem=strict \
      --property=PrivateDevices=yes \
      --property=PrivateTmp=yes \
      --property=RestrictSUIDSGID=yes \
      --property=SystemCallFilter=~@mount \
      --property="BindReadOnlyPaths=${ROOT}" \
      --property="BindReadOnlyPaths=${PFTERMINAL_INSTALL}" \
      --property="BindPaths=${REVIEW_STATE}" \
      --property="BindPaths=${CODEX_AUTH}:${REVIEW_STATE}/auth.json" \
      "${PFTERMINAL_BIN}" review --uncommitted
    ;;
  core)
    shift
    exec "${ROOT}/city2-core" "$@"
    ;;
  buzz)
    shift
    [[ "$#" -gt 0 ]] || {
      echo "city2: missing Buzz command" >&2
      exit 2
    }
    exec "${ROOT}/infra/buzz/run.sh" "$@"
    ;;
  status)
    printf 'city2=%s\n' "$(cat "${ROOT}/VERSION")"
    git -C "${ROOT}" status --short --branch
    "${ROOT}/scripts/runtime_status.py" --format status
    if [[ -f "${ROOT}/infra/buzz/.env" ]]; then
      "${ROOT}/infra/buzz/run.sh" status
    else
      echo "buzz=not-configured"
    fi
    ;;
  version)
    printf 'city2 %s\n' "$(cat "${ROOT}/VERSION")"
    if command -v pfterminal >/dev/null 2>&1; then
      pfterminal --version
    else
      echo "pfterminal unavailable"
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "city2: unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
