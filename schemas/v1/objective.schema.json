{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/objective.schema.json",
  "title": "City2 objective revision v1",
  "type": "object",
  "required": [
    "schema_version", "objective_id", "aggregate_version", "objective_revision", "objective_sha256",
    "title", "intent", "created_by", "accountable_owner", "created_at",
    "review_at", "measurable_outcomes", "stop_conditions", "authority_ceiling",
    "budget", "status"
  ],
  "properties": {
    "schema_version": {"const": "city2.objective/v1"},
    "objective_id": {"$ref": "common.schema.json#/$defs/objective_id"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "objective_revision": {"type": "integer", "minimum": 1},
    "objective_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "intent": {"type": "string", "minLength": 1, "maxLength": 8000},
    "created_by": {"$ref": "common.schema.json#/$defs/actor"},
    "accountable_owner": {"$ref": "common.schema.json#/$defs/actor"},
    "created_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "review_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "measurable_outcomes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outcome_id", "measure", "target"],
        "properties": {
          "outcome_id": {"type": "string", "pattern": "^oc_[a-z0-9._-]+$"},
          "measure": {"type": "string", "minLength": 1, "maxLength": 1000},
          "target": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "additionalProperties": false
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "authority_ceiling": {"$ref": "common.schema.json#/$defs/authority_class"},
    "budget": {"$ref": "common.schema.json#/$defs/budget"},
    "status": {"enum": ["proposed", "active", "paused", "completed", "cancelled", "superseded"]},
    "supersedes": {
      "type": "object",
      "required": ["objective_id", "objective_revision", "objective_sha256"],
      "properties": {
        "objective_id": {"$ref": "common.schema.json#/$defs/objective_id"},
        "objective_revision": {"type": "integer", "minimum": 1},
        "objective_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
