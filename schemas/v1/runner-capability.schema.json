{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/runner-capability.schema.json",
  "title": "City2 runner capability manifest v1",
  "type": "object",
  "required": [
    "schema_version", "runner_id", "runner_version", "contract_versions",
    "capabilities", "unsupported", "degraded", "manifest_sha256", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "city2.runner-capability/v1"},
    "runner_id": {"$ref": "common.schema.json#/$defs/non_secret_name"},
    "runner_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "contract_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^city2\\.[a-z0-9-]+/v[1-9][0-9]*$"}},
    "capabilities": {
      "type": "object",
      "required": [
        "structured_output", "tool_schema_fidelity", "sandboxing", "cancellation",
        "usage_accounting", "model_controls", "budget_enforcement", "artifact_hashing"
      ],
      "properties": {
        "structured_output": {"enum": ["enforced", "best_effort", "unsupported"]},
        "tool_schema_fidelity": {"enum": ["enforced", "best_effort", "unsupported"]},
        "sandboxing": {"enum": ["process", "container", "host_policy", "unsupported"]},
        "cancellation": {"enum": ["hard", "cooperative", "unsupported"]},
        "usage_accounting": {"enum": ["exact", "estimated", "unsupported"]},
        "model_controls": {"enum": ["enforced", "partial", "unsupported"]},
        "budget_enforcement": {"enum": ["hard", "best_effort", "unsupported"]},
        "artifact_hashing": {"enum": ["sha256", "unsupported"]}
      },
      "additionalProperties": false
    },
    "unsupported": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_secret_name"}},
    "degraded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "reason_code"],
        "properties": {
          "capability": {"$ref": "common.schema.json#/$defs/non_secret_name"},
          "reason_code": {"$ref": "common.schema.json#/$defs/non_secret_name"}
        },
        "additionalProperties": false
      }
    },
    "manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "generated_at": {"$ref": "common.schema.json#/$defs/date_time"}
  },
  "additionalProperties": false
}
