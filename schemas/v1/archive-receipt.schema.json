{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/archive-receipt.schema.json",
  "title": "City2 minimal signed archive availability receipt v1",
  "type": "object",
  "required": [
    "schema_version", "archive_id", "backend", "backend_object_id",
    "ciphertext_sha256", "snapshot_sequence", "stored_at", "verified_at",
    "checkpoint_key_version", "signature_algorithm", "signature"
  ],
  "properties": {
    "schema_version": {"const": "city2.archive-receipt/v1"},
    "archive_id": {"$ref": "common.schema.json#/$defs/archive_id"},
    "backend": {"$ref": "common.schema.json#/$defs/non_secret_name"},
    "backend_object_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "ciphertext_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "snapshot_sequence": {"type": "integer", "minimum": 1},
    "storage_end_epoch": {"type": "integer", "minimum": 0},
    "stored_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "verified_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "checkpoint_key_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "signature_algorithm": {"enum": ["ed25519"]},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}
  },
  "additionalProperties": false
}
