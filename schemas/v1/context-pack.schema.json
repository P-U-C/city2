{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/context-pack.schema.json",
  "title": "City2 deterministic context-pack manifest v1",
  "type": "object",
  "required": [
    "schema_version", "context_id", "task_id", "task_envelope_sha256",
    "assembler", "retrieval_policy", "tokenizer", "normalized_query",
    "source_snapshot", "candidate_memory_ids", "filters", "ranked_candidates",
    "selected", "excluded", "tie_break", "sections", "total_tokens",
    "pack_sha256", "sensitivity", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "city2.context-pack/v1"},
    "context_id": {"$ref": "common.schema.json#/$defs/context_id"},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "task_envelope_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "assembler": {"$ref": "common.schema.json#/$defs/validator"},
    "retrieval_policy": {"$ref": "common.schema.json#/$defs/validator"},
    "tokenizer": {"$ref": "common.schema.json#/$defs/validator"},
    "normalized_query": {"type": "string", "maxLength": 8000},
    "source_snapshot": {
      "type": "object",
      "required": ["event_high_water", "memory_projection_sha256"],
      "properties": {
        "event_high_water": {"type": "integer", "minimum": 0},
        "memory_projection_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "candidate_memory_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/memory_id"}},
    "filters": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "ranked_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memory_id", "score", "rank"],
        "properties": {
          "memory_id": {"$ref": "common.schema.json#/$defs/memory_id"},
          "score": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,8})?$"},
          "rank": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memory_id", "excerpt", "excerpt_sha256", "section", "token_count"],
        "properties": {
          "memory_id": {"$ref": "common.schema.json#/$defs/memory_id"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 20000},
          "excerpt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "section": {"$ref": "common.schema.json#/$defs/non_secret_name"},
          "token_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memory_id", "reason"],
        "properties": {
          "memory_id": {"$ref": "common.schema.json#/$defs/memory_id"},
          "reason": {"$ref": "common.schema.json#/$defs/non_secret_name"}
        },
        "additionalProperties": false
      }
    },
    "tie_break": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/non_secret_name"}},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "token_budget", "token_count", "truncated"],
        "properties": {
          "name": {"$ref": "common.schema.json#/$defs/non_secret_name"},
          "token_budget": {"type": "integer", "minimum": 0},
          "token_count": {"type": "integer", "minimum": 0},
          "truncated": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "total_tokens": {"type": "integer", "minimum": 0},
    "pack_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "sensitivity": {"$ref": "common.schema.json#/$defs/sensitivity"},
    "created_at": {"$ref": "common.schema.json#/$defs/date_time"}
  },
  "additionalProperties": false
}
