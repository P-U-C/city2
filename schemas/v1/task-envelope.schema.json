{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/task-envelope.schema.json",
  "title": "City2 immutable task dispatch envelope v1",
  "type": "object",
  "required": [
    "schema_version", "task_id", "task_revision", "task_envelope_sha256",
    "objective_id", "objective_revision", "objective_sha256", "task_type",
    "title", "intent", "created_by", "requested_role", "resolved_agent_id",
    "resolved_manifest_version", "resolved_manifest_sha256", "attempt_number",
    "expected_task_version", "lease_fencing_token", "authority_class", "inputs",
    "constraints", "acceptance_criteria", "memory_scopes", "time_budget_seconds",
    "max_attempts", "task_dedupe_key"
  ],
  "properties": {
    "schema_version": {"const": "city2.task/v1"},
    "task_id": {"$ref": "common.schema.json#/$defs/task_id"},
    "task_revision": {"type": "integer", "minimum": 1},
    "task_envelope_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "objective_id": {"$ref": "common.schema.json#/$defs/objective_id"},
    "objective_revision": {"type": "integer", "minimum": 1},
    "objective_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "task_type": {"$ref": "common.schema.json#/$defs/non_secret_name"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "intent": {"type": "string", "minLength": 1, "maxLength": 8000},
    "created_by": {"$ref": "common.schema.json#/$defs/actor"},
    "requested_role": {"$ref": "common.schema.json#/$defs/non_secret_name"},
    "resolved_agent_id": {"$ref": "common.schema.json#/$defs/agent_id"},
    "resolved_manifest_version": {"type": "integer", "minimum": 1},
    "resolved_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "expected_task_version": {"type": "integer", "minimum": 1},
    "lease_fencing_token": {"type": "string", "minLength": 16, "maxLength": 256},
    "authority_class": {"$ref": "common.schema.json#/$defs/authority_class"},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri"],
        "properties": {
          "uri": {"$ref": "common.schema.json#/$defs/uri"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "git_commit_sha1": {"$ref": "common.schema.json#/$defs/git_sha1"}
        },
        "anyOf": [
          {"required": ["sha256"]},
          {"required": ["git_commit_sha1"]}
        ],
        "additionalProperties": false
      }
    },
    "constraints": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_secret_name"}},
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "requirement", "mandatory"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^ac_[a-z0-9._-]+$"},
          "requirement": {"type": "string", "minLength": 1, "maxLength": 2000},
          "mandatory": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "memory_scopes": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/scope"}},
    "time_budget_seconds": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1},
    "task_dedupe_key": {"$ref": "common.schema.json#/$defs/idempotency_key"},
    "supersedes_run_id": {"$ref": "common.schema.json#/$defs/run_id"},
    "review_id": {"$ref": "common.schema.json#/$defs/review_id"},
    "unresolved_finding_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/finding_id"}}
  },
  "additionalProperties": false
}
