{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/authority-decision.schema.json",
  "title": "City2 content-free authority decision trace v1",
  "type": "object",
  "required": [
    "schema_version", "decision", "operation_idempotency_key", "authority_class",
    "policy_versions", "checks", "evaluated_at"
  ],
  "properties": {
    "schema_version": {"const": "city2.authority-decision/v1"},
    "decision": {"enum": ["allow", "deny"]},
    "operation_idempotency_key": {"$ref": "common.schema.json#/$defs/idempotency_key"},
    "authority_class": {"$ref": "common.schema.json#/$defs/authority_class"},
    "policy_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "result", "reason_code"],
        "properties": {
          "dimension": {"enum": ["task", "manifest", "runner", "tool", "filesystem", "network", "credential", "authority", "approval"]},
          "result": {"enum": ["allow", "deny", "missing", "stale", "conflict", "invalid"]},
          "reason_code": {"$ref": "common.schema.json#/$defs/non_secret_name"}
        },
        "additionalProperties": false
      }
    },
    "evaluated_at": {"$ref": "common.schema.json#/$defs/date_time"}
  },
  "additionalProperties": false
}
