{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/archive-envelope.schema.json",
  "title": "City2 backend-neutral encrypted archive envelope v1",
  "type": "object",
  "required": [
    "schema_version", "archive_id", "snapshot_sequence", "cipher_profile",
    "recipient_fingerprints", "key_versions", "inner_manifest_sha256",
    "checkpoint_sha256", "ciphertext_sha256", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "city2.archive-envelope/v1"},
    "archive_id": {"$ref": "common.schema.json#/$defs/archive_id"},
    "snapshot_sequence": {"type": "integer", "minimum": 1},
    "cipher_profile": {"const": "age-v1-x25519"},
    "recipient_fingerprints": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "key_versions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
    },
    "inner_manifest_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "checkpoint_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "ciphertext_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "created_at": {"$ref": "common.schema.json#/$defs/date_time"}
  },
  "additionalProperties": false
}
