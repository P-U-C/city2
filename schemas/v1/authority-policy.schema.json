{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/authority-policy.schema.json",
  "title": "City2 deny-by-default authority policy vocabulary v1",
  "type": "object",
  "required": [
    "schema_version", "policy_version", "default_effect", "combining_algorithm",
    "required_dimensions", "classes", "approval_binding", "separation_of_duties",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "city2.authority-policy/v1"},
    "policy_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "default_effect": {"const": "deny"},
    "combining_algorithm": {"const": "deny_overrides_intersection"},
    "required_dimensions": {
      "type": "array", "minItems": 9, "uniqueItems": true,
      "items": {"enum": ["task", "manifest", "runner", "tool", "filesystem", "network", "credential", "authority", "approval"]}
    },
    "classes": {
      "type": "object",
      "required": ["A0", "A1", "A2", "A3", "A4"],
      "properties": {
        "A0": {"$ref": "#/$defs/class"},
        "A1": {"$ref": "#/$defs/class"},
        "A2": {"$ref": "#/$defs/class"},
        "A3": {"$ref": "#/$defs/class"},
        "A4": {"$ref": "#/$defs/class"}
      },
      "additionalProperties": false
    },
    "approval_binding": {
      "type": "object",
      "required": ["exact_operation", "atomic_consumption", "invalidate_on_change"],
      "properties": {
        "exact_operation": {"const": true},
        "atomic_consumption": {"const": true},
        "invalidate_on_change": {
          "type": "array", "minItems": 6, "uniqueItems": true,
          "items": {"enum": ["parameters", "target", "artifact", "task_revision", "policy_version", "expiry", "revocation", "execution_limit"]}
        }
      },
      "additionalProperties": false
    },
    "separation_of_duties": {
      "type": "object",
      "required": ["required_from", "maker_may_self_review", "reviewer_may_execute"],
      "properties": {
        "required_from": {"const": "A1"},
        "maker_may_self_review": {"const": false},
        "reviewer_may_execute": {"const": false}
      },
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/non_secret_name"}
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "required": ["description", "operation_families", "approval"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "operation_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_secret_name"}},
        "approval": {"enum": ["policy", "policy_and_independent_review", "human", "human_at_action_time", "hardened_operator"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
