{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p-u-c.github.io/city2/schemas/v1/deletion-order.schema.json",
  "title": "City2 privacy/legal deletion order v1",
  "type": "object",
  "required": [
    "schema_version", "deletion_id", "aggregate_version", "requested_by",
    "approved_by", "policy_version", "reason_code", "subject_selectors",
    "scope", "issued_at", "execute_by", "state", "targets", "order_sha256"
  ],
  "properties": {
    "schema_version": {"const": "city2.deletion-order/v1"},
    "deletion_id": {"$ref": "common.schema.json#/$defs/deletion_id"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "requested_by": {"$ref": "common.schema.json#/$defs/actor"},
    "approved_by": {"$ref": "common.schema.json#/$defs/actor"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason_code": {"$ref": "common.schema.json#/$defs/non_secret_name"},
    "subject_selectors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "value_sha256"],
        "properties": {
          "kind": {"enum": ["memory", "artifact", "source", "external_subject"]},
          "value_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["core", "search_indexes", "artifacts", "backups", "archive_keys", "external_backends"]}},
    "issued_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "execute_by": {"$ref": "common.schema.json#/$defs/date_time"},
    "state": {"enum": ["ordered", "executing", "blocked", "completed", "failed"]},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backend", "locator_sha256", "state"],
        "properties": {
          "backend": {"$ref": "common.schema.json#/$defs/non_secret_name"},
          "locator_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "state": {"enum": ["pending", "deleted", "crypto_erased", "not_found", "blocked", "failed"]},
          "verified_at": {"$ref": "common.schema.json#/$defs/date_time"}
        },
        "additionalProperties": false
      }
    },
    "order_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "proof_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "completed_at": {"$ref": "common.schema.json#/$defs/date_time"}
  },
  "additionalProperties": false
}
